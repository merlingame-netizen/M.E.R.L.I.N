{
  "name": "merlin-studio",
  "displayName": "MERLIN Studio (VM)",
  "description": "Pilote le studio de dev MERLIN hébergé sur la VM Oracle : tester le jeu (smoke/tests Godot), générer du contenu, interroger le modèle Gemma 4, suivre les jobs — sans quitter VS Code.",
  "version": "1.0.0",
  "publisher": "merlin-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "keywords": [
    "merlin",
    "godot",
    "ollama",
    "gemma",
    "vm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "merlin-studio",
          "title": "MERLIN Studio",
          "icon": "media/merlin.svg"
        }
      ]
    },
    "views": {
      "merlin-studio": [
        {
          "id": "merlinStudio.scenes",
          "name": "Scènes du jeu"
        },
        {
          "id": "merlinStudio.jobs",
          "name": "Jobs"
        },
        {
          "id": "merlinStudio.vm",
          "name": "VM & modèles"
        }
      ]
    },
    "commands": [
      {
        "command": "merlinStudio.openPortal",
        "title": "MERLIN: Ouvrir le portail VM (dans VS Code)",
        "icon": "$(globe)"
      },
      {
        "command": "merlinStudio.mfaVerify",
        "title": "MERLIN: Vérifier MFA (second facteur)",
        "icon": "$(shield)"
      },
      {
        "command": "merlinStudio.configure",
        "title": "MERLIN: Configurer la connexion (URL + token)",
        "icon": "$(gear)"
      },
      {
        "command": "merlinStudio.openDashboard",
        "title": "MERLIN: Ouvrir le tableau de bord",
        "icon": "$(dashboard)"
      },
      {
        "command": "merlinStudio.refresh",
        "title": "MERLIN: Rafraîchir",
        "icon": "$(refresh)"
      },
      {
        "command": "merlinStudio.smokeScene",
        "title": "MERLIN: Tester une scène (smoke)"
      },
      {
        "command": "merlinStudio.smokeAll",
        "title": "MERLIN: Tester TOUTES les scènes"
      },
      {
        "command": "merlinStudio.runTests",
        "title": "MERLIN: Lancer la suite de tests (headless)"
      },
      {
        "command": "merlinStudio.bootCheck",
        "title": "MERLIN: Boot check (rapide)"
      },
      {
        "command": "merlinStudio.generateContent",
        "title": "MERLIN: Générer des cartes"
      },
      {
        "command": "merlinStudio.validateContent",
        "title": "MERLIN: Valider le contenu"
      },
      {
        "command": "merlinStudio.askModel",
        "title": "MERLIN: Demander au modèle du jeu (Gemma 4)"
      },
      {
        "command": "merlinStudio.pullModel",
        "title": "MERLIN: Télécharger un modèle Ollama"
      },
      {
        "command": "merlinStudio.startVoice",
        "title": "MERLIN: Démarrer les services voix (TTS/ASR)"
      },
      {
        "command": "merlinStudio.gitPull",
        "title": "MERLIN: Mettre à jour le dépôt (pull ff-only)"
      },
      {
        "command": "merlinStudio.showLog",
        "title": "MERLIN: Voir le log d'un job",
        "icon": "$(output)"
      },
      {
        "command": "merlinStudio.stopJob",
        "title": "MERLIN: Arrêter un job en cours"
      },
      {
        "command": "merlinStudio.runAny",
        "title": "MERLIN: Lancer une action (liste complète)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "merlinStudio.refresh",
          "when": "view =~ /merlinStudio/",
          "group": "navigation@1"
        },
        {
          "command": "merlinStudio.openDashboard",
          "when": "view =~ /merlinStudio/",
          "group": "navigation@2"
        },
        {
          "command": "merlinStudio.configure",
          "when": "view =~ /merlinStudio/",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "merlinStudio.showLog",
          "when": "viewItem == merlinJob",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "MERLIN Studio",
      "properties": {
        "merlinStudio.url": {
          "type": "string",
          "default": "",
          "description": "URL du studio sur la VM (ex. https://xxx.trycloudflare.com ou http://127.0.0.1:8790)."
        },
        "merlinStudio.user": {
          "type": "string",
          "default": "merlin",
          "description": "Utilisateur Basic-auth du studio."
        },
        "merlinStudio.refreshSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "Intervalle de rafraîchissement automatique (secondes). 0 = désactivé."
        },
        "merlinStudio.autoOpenLog": {
          "type": "boolean",
          "default": true,
          "description": "Ouvrir automatiquement la sortie et suivre le log quand un job est lancé."
        }
      }
    }
  }
}

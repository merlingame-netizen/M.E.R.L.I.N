#cloud-config
# M.E.R.L.I.N. — Oracle ARM A1 provisioning
# Rendered by Terraform (templatefile). Installs: dev base, Node 20, Ollama+Gemma,
# Godot headless (arm64), Claude Code. See infra/oracle/README.md.

package_update: true
package_upgrade: true

packages:
  - git
  - curl
  - wget
  - unzip
  - build-essential
  - htop
  - jq
  - ca-certificates
  - gnupg
  - ufw
  - python3
  - python3-pip
  - python3-venv
  - tmux
  - software-properties-common

write_files:
  - path: /etc/sysctl.d/99-merlin.conf
    content: |
      vm.swappiness=10

  - path: /opt/merlin/pull-models.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      # Skip model pulls on low-RAM hosts (e.g. E2.1.Micro 1GB) — they can't run them.
      mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
      if [ "$mem_kb" -lt 4000000 ]; then
        echo "RAM < 4GB: skipping LLM model pulls" > /opt/merlin/MODELS_DONE
        exit 0
      fi
      # Wait until the Ollama daemon answers before pulling.
      for _ in $(seq 1 60); do
        if curl -fsS http://localhost:11434/api/version >/dev/null 2>&1; then break; fi
        sleep 5
      done
%{ for m in ollama_models ~}
      ollama pull ${m} || true
%{ endfor ~}
      echo "models-done" > /opt/merlin/MODELS_DONE

  - path: /opt/merlin/README.txt
    content: |
      M.E.R.L.I.N. host — provisioned by Terraform/cloud-init.
      Ollama API: http://127.0.0.1:11434 (tunnel from your machine:
        ssh -N -L 11434:localhost:11434 ${os_username}@<public_ip>)
      Godot headless: /usr/local/bin/godot  (godot --headless --version)
      Claude Code:    claude  (run `claude` after `npm i -g @anthropic-ai/claude-code` if missing)
      Workspace:      /home/${os_username}/workspace
      Provision logs: /var/log/cloud-init-output.log , /var/log/merlin-models.log

  # --- Shell shortcuts (the "bridge" convenience, VM side) ---
  - path: /etc/profile.d/merlin.sh
    content: |
      # M.E.R.L.I.N. shell shortcuts
      alias ws='cd /home/${os_username}/workspace'
      alias ll='ls -alh'
      alias gv='godot --headless --version'
      alias ol='ollama list'
      alias merlin='/usr/local/bin/merlin-status'
      alias dc='docker compose -f /opt/merlin/stack/docker-compose.yml'
      alias venv='source /home/${os_username}/workspace/M.E.R.L.I.N/.venv/bin/activate'
      export EDITOR=nano

  - path: /usr/local/bin/merlin-status
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      echo "=== M.E.R.L.I.N. host status ==="
      echo "Godot  : $(/usr/local/bin/godot --headless --version 2>/dev/null || echo n/a)"
      echo "Ollama : $(curl -fsS http://localhost:11434/api/version 2>/dev/null | jq -r .version 2>/dev/null || echo down)"
      echo "Claude : $(claude --version 2>/dev/null || echo 'not installed')"
      echo "Runner : $(systemctl is-active merlin-runner 2>/dev/null || echo n/a)"
      echo "Models :"; ollama list 2>/dev/null | sed 's/^/  /'
      echo "Stack  :"; docker ps --filter name=merlin- --format '  {{.Names}}: {{.Status}}' 2>/dev/null || echo "  (docker n/a)"
      echo "Secrets: /opt/merlin/stack/.env (code-server + postgres passwords)"
      echo "Workspace: $(ls /home/${os_username}/workspace 2>/dev/null | tr '\n' ' ')"

  - path: /etc/update-motd.d/99-merlin
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      echo ""
      echo "  M.E.R.L.I.N. ARM A1 host — type 'merlin' for status, 'ws' for workspace"
      echo ""
%{ if enable_claude_runner ~}
  # --- Claude Code runner (systemd) ---
  - path: /opt/merlin/runner.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      ENV_FILE=/etc/merlin/runner.env
      if [ -f "$ENV_FILE" ]; then set -a; . "$ENV_FILE"; set +a; fi
      if [ -z "$${ANTHROPIC_API_KEY:-}" ]; then
        echo "merlin-runner: ANTHROPIC_API_KEY not set in $ENV_FILE — idle."
        echo "Configure it and run: sudo systemctl restart merlin-runner"
        exit 0
      fi
      cd "$${RUNNER_WORKDIR:-/home/${os_username}/workspace}"
      exec $${RUNNER_CMD:-claude --version}

  - path: /etc/merlin/runner.env.example
    content: |
      # Copy to /etc/merlin/runner.env, fill in, then:
      #   sudo systemctl restart merlin-runner && journalctl -u merlin-runner -f
      ANTHROPIC_API_KEY=
      RUNNER_WORKDIR=/home/${os_username}/workspace/M.E.R.L.I.N
      # Command the runner executes headless. Examples:
      #   RUNNER_CMD=claude -p "run validate + smoke and summarize failures"
      #   RUNNER_CMD=bash tools/autodev/run.sh
      RUNNER_CMD=claude --version

  - path: /etc/systemd/system/merlin-runner.service
    content: |
      [Unit]
      Description=M.E.R.L.I.N. Claude Code runner
      After=network-online.target ollama.service
      Wants=network-online.target

      [Service]
      Type=simple
      User=${os_username}
      EnvironmentFile=-/etc/merlin/runner.env
      ExecStart=/opt/merlin/runner.sh
      Restart=on-failure
      RestartSec=30

      [Install]
      WantedBy=multi-user.target
%{ endif ~}

  # --- merlin-narrator: create only if the LoRA gguf is present (else skip cleanly) ---
  - path: /opt/merlin/create-narrator.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      REPO=/home/${os_username}/workspace/M.E.R.L.I.N
      MF="$REPO/Modelfile"
      GGUF="$REPO/addons/merlin_llm/adapters/merlin_narrator_lora.gguf"
      [ -f "$MF" ] || { echo "no Modelfile, skip"; exit 0; }
      if [ ! -s "$GGUF" ]; then
        echo "LoRA gguf missing ($GGUF) — skipping merlin-narrator."
        echo "Place the .gguf then: cd $REPO && ollama create merlin-narrator -f Modelfile"
        exit 0
      fi
      for _ in $(seq 1 60); do
        curl -fsS http://localhost:11434/api/version >/dev/null 2>&1 && break
        sleep 5
      done
      cd "$REPO"
      ollama create merlin-narrator -f Modelfile && echo "merlin-narrator created."
%{ if enable_dev_stack ~}
  # --- Make host Ollama reachable from containers (still loopback+bridge only) ---
  - path: /etc/systemd/system/ollama.service.d/override.conf
    content: |
      [Service]
      Environment="OLLAMA_HOST=0.0.0.0:11434"

  # --- Dev stack: Open WebUI + code-server + Filebrowser + PostgreSQL (127.0.0.1 only) ---
  - path: /opt/merlin/stack/docker-compose.yml
    content: |
      name: merlin-stack
      services:
        open-webui:
          image: ghcr.io/open-webui/open-webui:$${OPENWEBUI_TAG:-main}
          container_name: merlin-open-webui
          environment:
            - OLLAMA_BASE_URL=http://host.docker.internal:11434
            - WEBUI_AUTH=true
            - WEBUI_SECRET_KEY=$${WEBUI_SECRET_KEY}
          extra_hosts:
            - "host.docker.internal:host-gateway"
          ports:
            - "127.0.0.1:3000:8080"
          volumes:
            - openwebui_data:/app/backend/data
          networks: [merlin]
          restart: unless-stopped
        code-server:
          image: lscr.io/linuxserver/code-server:latest
          container_name: merlin-code-server
          environment:
            - PUID=1000
            - PGID=1000
            - TZ=$${TZ:-Europe/Paris}
            - PASSWORD=$${CODESERVER_PASSWORD}
            - DEFAULT_WORKSPACE=/config/workspace
          ports:
            - "127.0.0.1:8443:8443"
          volumes:
            - codeserver_config:/config
            - /home/${os_username}/workspace:/config/workspace
          networks: [merlin]
          restart: unless-stopped
        filebrowser:
          image: filebrowser/filebrowser:s6
          container_name: merlin-filebrowser
          environment:
            - PUID=1000
            - PGID=1000
          ports:
            - "127.0.0.1:8081:80"
          volumes:
            - /home/${os_username}/workspace:/srv
            - filebrowser_db:/database
          networks: [merlin]
          restart: unless-stopped
        postgres:
          image: postgres:16-alpine
          container_name: merlin-postgres
          environment:
            - POSTGRES_USER=$${POSTGRES_USER:-merlin}
            - POSTGRES_PASSWORD=$${POSTGRES_PASSWORD}
            - POSTGRES_DB=$${POSTGRES_DB:-merlin}
          ports:
            - "127.0.0.1:5432:5432"
          volumes:
            - pgdata:/var/lib/postgresql/data
          networks: [merlin]
          restart: unless-stopped
          healthcheck:
            test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER:-merlin}"]
            interval: 30s
            timeout: 5s
            retries: 5
      networks:
        merlin:
          driver: bridge
      volumes:
        openwebui_data:
        codeserver_config:
        filebrowser_db:
        pgdata:

  - path: /opt/merlin/stack/gen-env.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      ENV=/opt/merlin/stack/.env
      [ -f "$ENV" ] && exit 0
      gen() { openssl rand -hex 24; }
      cat > "$ENV" <<EOF
      OPENWEBUI_TAG=${openwebui_tag}
      WEBUI_SECRET_KEY=$(gen)
      CODESERVER_PASSWORD=$(gen)
      POSTGRES_USER=merlin
      POSTGRES_PASSWORD=$(gen)
      POSTGRES_DB=merlin
      TZ=Europe/Paris
      EOF
      chmod 600 "$ENV"
      echo "Stack secrets written to $ENV"

  - path: /etc/systemd/system/merlin-stack.service
    content: |
      [Unit]
      Description=M.E.R.L.I.N. dev stack (docker compose)
      Requires=docker.service
      After=docker.service network-online.target ollama.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/merlin/stack
      ExecStart=/usr/bin/docker compose up -d
      ExecStop=/usr/bin/docker compose down
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target
%{ endif ~}
%{ if enable_blender ~}
  # --- Blender headless via container (arm64; version NOT guaranteed 4.5) ---
  - path: /usr/local/bin/blender
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # WARNING: arm64 Blender may not be 4.5 — verify `blender --version`.
      exec docker run --rm -v /home/${os_username}/workspace:/workspace \
        lscr.io/linuxserver/blender:latest /usr/bin/blender --background "$@"
%{ endif ~}

runcmd:
  - sysctl --system || true
  # 8 GB swap for headroom when loading larger quantized models.
  - |
    if [ ! -f /swapfile ]; then
      fallocate -l 8G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi
  # Node.js 20 (for MERLIN server build + Claude Code CLI)
  - curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  - apt-get install -y nodejs
  - npm install -g @anthropic-ai/claude-code || true
  # Ollama (systemd service, binds 127.0.0.1:11434 by default)
  - curl -fsSL https://ollama.com/install.sh | sh
  - systemctl enable --now ollama || true
%{ if enable_dev_stack ~}
  - systemctl daemon-reload && systemctl restart ollama || true
%{ endif ~}
%{ if enable_dev_stack || enable_blender ~}
  # Docker engine + compose v2 (arm64, official apt repo)
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu jammy stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - usermod -aG docker ${os_username}
  - systemctl enable --now docker
%{ endif ~}
  # Godot headless (arm64)
  - |
    GODOT_VER="${godot_version}"
    case "$(uname -m)" in aarch64) GODOT_ARCH=arm64 ;; *) GODOT_ARCH=x86_64 ;; esac
    cd /tmp
    wget -q "https://github.com/godotengine/godot/releases/download/$${GODOT_VER}-stable/Godot_v$${GODOT_VER}-stable_linux.$${GODOT_ARCH}.zip" -O godot.zip
    unzip -o godot.zip
    install -m 0755 "Godot_v$${GODOT_VER}-stable_linux.$${GODOT_ARCH}" /usr/local/bin/godot
    /usr/local/bin/godot --headless --version || true
  # Firewall (defense-in-depth; OCI security list is the primary control)
  - ufw allow OpenSSH
%{ if expose_ollama ~}
  - ufw allow 11434/tcp
%{ endif ~}
  - ufw --force enable
  # Pull Gemma models in the background (first boot can take a while)
  - bash /opt/merlin/pull-models.sh > /var/log/merlin-models.log 2>&1 &
  # Workspace + optional repo mirror
  - install -d -o ${os_username} -g ${os_username} /home/${os_username}/workspace
%{ for repo in git_repos ~}
  - sudo -u ${os_username} git clone ${repo} "/home/${os_username}/workspace/$(basename ${repo} .git)" || true
%{ endfor ~}
%{ if enable_claude_runner ~}
  # Claude Code runner: enable for boot; stays idle until runner.env is configured.
  - mkdir -p /etc/merlin
  - systemctl daemon-reload
  - systemctl enable merlin-runner.service || true
%{ endif ~}
  # Python venv for the CLI tooling (arm64: FreeTDS for SQL Server; MS driver unavailable)
  - apt-get install -y unixodbc-dev freetds-dev tdsodbc || true
  - |
    sudo -u ${os_username} bash -c '
      cd /home/${os_username}/workspace/M.E.R.L.I.N 2>/dev/null || exit 0
      python3 -m venv .venv && . .venv/bin/activate
      pip install --upgrade pip wheel >/dev/null 2>&1
      pip install -r tools/data_explorer/requirements.txt || echo "partial arm64 install — see log"
    ' > /var/log/merlin-pyenv.log 2>&1 || true
%{ if enable_blender ~}
  - docker pull lscr.io/linuxserver/blender:latest || true
%{ endif ~}
%{ if enable_dev_stack ~}
  # Dev stack: generate secrets + bring it up (idempotent via systemd)
  - bash /opt/merlin/stack/gen-env.sh || true
  - systemctl daemon-reload
  - systemctl enable --now merlin-stack.service || true
%{ endif ~}
  # Create merlin-narrator if the LoRA gguf is present (else skip cleanly)
  - bash /opt/merlin/create-narrator.sh > /var/log/merlin-narrator.log 2>&1 &
  - touch /opt/merlin/PROVISION_DONE

final_message: "M.E.R.L.I.N. host provisioned in $UPTIME s — see /opt/merlin/README.txt"

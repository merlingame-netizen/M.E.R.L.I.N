#cloud-config
# M.E.R.L.I.N. — Oracle ARM A1 provisioning
# Rendered by Terraform (templatefile). Installs: dev base, Node 20, Ollama+Gemma,
# Godot headless (arm64), Claude Code. See infra/oracle/README.md.

package_update: true
package_upgrade: true

packages:
  - git
  - curl
  - wget
  - unzip
  - build-essential
  - htop
  - jq
  - ca-certificates
  - gnupg
  - ufw
  - python3
  - python3-pip
  - python3-venv
  - tmux
  - software-properties-common

write_files:
  - path: /etc/sysctl.d/99-merlin.conf
    content: |
      vm.swappiness=10

  - path: /opt/merlin/pull-models.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      # Skip model pulls on low-RAM hosts (e.g. E2.1.Micro 1GB) — they can't run them.
      mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
      if [ "$mem_kb" -lt 4000000 ]; then
        echo "RAM < 4GB: skipping LLM model pulls" > /opt/merlin/MODELS_DONE
        exit 0
      fi
      # Wait until the Ollama daemon answers before pulling.
      for _ in $(seq 1 60); do
        if curl -fsS http://localhost:11434/api/version >/dev/null 2>&1; then break; fi
        sleep 5
      done
%{ for m in ollama_models ~}
      ollama pull ${m} || true
%{ endfor ~}
      echo "models-done" > /opt/merlin/MODELS_DONE

  - path: /opt/merlin/README.txt
    content: |
      M.E.R.L.I.N. host — provisioned by Terraform/cloud-init.
      Ollama API: http://127.0.0.1:11434 (tunnel from your machine:
        ssh -N -L 11434:localhost:11434 ${os_username}@<public_ip>)
      Godot headless: /usr/local/bin/godot  (godot --headless --version)
      Claude Code:    claude  (run `claude` after `npm i -g @anthropic-ai/claude-code` if missing)
      Workspace:      /home/${os_username}/workspace
      Provision logs: /var/log/cloud-init-output.log , /var/log/merlin-models.log

  # --- Shell shortcuts (the "bridge" convenience, VM side) ---
  - path: /etc/profile.d/merlin.sh
    content: |
      # M.E.R.L.I.N. shell shortcuts
      alias ws='cd /home/${os_username}/workspace'
      alias ll='ls -alh'
      alias gv='godot --headless --version'
      alias ol='ollama list'
      alias merlin='/usr/local/bin/merlin-status'
      export EDITOR=nano

  - path: /usr/local/bin/merlin-status
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      echo "=== M.E.R.L.I.N. host status ==="
      echo "Godot  : $(/usr/local/bin/godot --headless --version 2>/dev/null || echo n/a)"
      echo "Ollama : $(curl -fsS http://localhost:11434/api/version 2>/dev/null | jq -r .version 2>/dev/null || echo down)"
      echo "Claude : $(claude --version 2>/dev/null || echo 'not installed')"
      echo "Runner : $(systemctl is-active merlin-runner 2>/dev/null || echo n/a)"
      echo "Models :"; ollama list 2>/dev/null | sed 's/^/  /'
      echo "Workspace: $(ls /home/${os_username}/workspace 2>/dev/null | tr '\n' ' ')"

  - path: /etc/update-motd.d/99-merlin
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      echo ""
      echo "  M.E.R.L.I.N. ARM A1 host — type 'merlin' for status, 'ws' for workspace"
      echo ""
%{ if enable_claude_runner ~}
  # --- Claude Code runner (systemd) ---
  - path: /opt/merlin/runner.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      ENV_FILE=/etc/merlin/runner.env
      if [ -f "$ENV_FILE" ]; then set -a; . "$ENV_FILE"; set +a; fi
      if [ -z "$${ANTHROPIC_API_KEY:-}" ]; then
        echo "merlin-runner: ANTHROPIC_API_KEY not set in $ENV_FILE — idle."
        echo "Configure it and run: sudo systemctl restart merlin-runner"
        exit 0
      fi
      cd "$${RUNNER_WORKDIR:-/home/${os_username}/workspace}"
      exec $${RUNNER_CMD:-claude --version}

  - path: /etc/merlin/runner.env.example
    content: |
      # Copy to /etc/merlin/runner.env, fill in, then:
      #   sudo systemctl restart merlin-runner && journalctl -u merlin-runner -f
      ANTHROPIC_API_KEY=
      RUNNER_WORKDIR=/home/${os_username}/workspace/M.E.R.L.I.N
      # Command the runner executes headless. Examples:
      #   RUNNER_CMD=claude -p "run validate + smoke and summarize failures"
      #   RUNNER_CMD=bash tools/autodev/run.sh
      RUNNER_CMD=claude --version

  - path: /etc/systemd/system/merlin-runner.service
    content: |
      [Unit]
      Description=M.E.R.L.I.N. Claude Code runner
      After=network-online.target ollama.service
      Wants=network-online.target

      [Service]
      Type=simple
      User=${os_username}
      EnvironmentFile=-/etc/merlin/runner.env
      ExecStart=/opt/merlin/runner.sh
      Restart=on-failure
      RestartSec=30

      [Install]
      WantedBy=multi-user.target
%{ endif ~}

runcmd:
  - sysctl --system || true
  # 8 GB swap for headroom when loading larger quantized models.
  - |
    if [ ! -f /swapfile ]; then
      fallocate -l 8G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi
  # Node.js 20 (for MERLIN server build + Claude Code CLI)
  - curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  - apt-get install -y nodejs
  - npm install -g @anthropic-ai/claude-code || true
  # Ollama (systemd service, binds 127.0.0.1:11434 by default)
  - curl -fsSL https://ollama.com/install.sh | sh
  - systemctl enable --now ollama || true
  # Godot headless (arm64)
  - |
    GODOT_VER="${godot_version}"
    case "$(uname -m)" in aarch64) GODOT_ARCH=arm64 ;; *) GODOT_ARCH=x86_64 ;; esac
    cd /tmp
    wget -q "https://github.com/godotengine/godot/releases/download/$${GODOT_VER}-stable/Godot_v$${GODOT_VER}-stable_linux.$${GODOT_ARCH}.zip" -O godot.zip
    unzip -o godot.zip
    install -m 0755 "Godot_v$${GODOT_VER}-stable_linux.$${GODOT_ARCH}" /usr/local/bin/godot
    /usr/local/bin/godot --headless --version || true
  # Firewall (defense-in-depth; OCI security list is the primary control)
  - ufw allow OpenSSH
%{ if expose_ollama ~}
  - ufw allow 11434/tcp
%{ endif ~}
  - ufw --force enable
  # Pull Gemma models in the background (first boot can take a while)
  - bash /opt/merlin/pull-models.sh > /var/log/merlin-models.log 2>&1 &
  # Workspace + optional repo mirror
  - install -d -o ${os_username} -g ${os_username} /home/${os_username}/workspace
%{ for repo in git_repos ~}
  - sudo -u ${os_username} git clone ${repo} "/home/${os_username}/workspace/$(basename ${repo} .git)" || true
%{ endfor ~}
%{ if enable_claude_runner ~}
  # Claude Code runner: enable for boot; stays idle until runner.env is configured.
  - mkdir -p /etc/merlin
  - systemctl daemon-reload
  - systemctl enable merlin-runner.service || true
%{ endif ~}
  - touch /opt/merlin/PROVISION_DONE

final_message: "M.E.R.L.I.N. host provisioned in $UPTIME s — see /opt/merlin/README.txt"

# Copy to .env and fill in. The VM generates a real .env with random secrets on
# first boot (/opt/merlin/stack/.env). Never commit the real .env.
OPENWEBUI_TAG=main
WEBUI_SECRET_KEY=change-me-long-random
CODESERVER_PASSWORD=change-me
POSTGRES_USER=merlin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=merlin
TZ=Europe/Paris

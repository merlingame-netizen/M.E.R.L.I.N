# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
# Values come from ../README.md Step 1-3.

# --- Auth (API signing key) ---
tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
user_ocid        = "ocid1.user.oc1..aaaa..."
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "eu-paris-1"

# Optional: deploy into a specific compartment (else tenancy root)
# compartment_ocid = "ocid1.compartment.oc1..aaaa..."

# --- Access ---
# Paste the FULL contents of your public key (e.g. ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Lock SSH to your IP (find it: curl ifconfig.me). /32 = single host.
# allowed_ssh_cidr = "203.0.113.7/32"

# --- Shape (Always Free maxes: 4 OCPU / 24 GB) ---
# ocpus                   = 4
# memory_in_gbs           = 24
# boot_volume_size_in_gbs = 100

# --- Capacity workaround: bump if you hit "Out of host capacity" ---
# availability_domain_number = 1

# --- Workloads ---
# ollama_models = ["gemma3:4b", "gemma3:12b"]
# godot_version = "4.4.1"
# git_repos     = ["https://github.com/merlingame-netizen/M.E.R.L.I.N.git"]

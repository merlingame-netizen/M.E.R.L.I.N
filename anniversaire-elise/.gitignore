# Données personnelles des invités — JAMAIS commitées.
# Régénérables via `python3 whatsapp/build_contacts.py` (le fichier source
# reste en local, hors dépôt).
whatsapp/contacts.vcf
whatsapp/contacts.csv
whatsapp/contacts_source.txt

# RIB : coordonnees bancaires reelles, injectees au deploiement.
# Le depot part sur GitHub — l'IBAN n'y a pas sa place.
deploy/rib.env

# Base des reponses au vote : donnees personnelles des invites.
vm/reponses.db
vm/__pycache__/

# Template genere par vm/build_template.py : contient l'IBAN injecte depuis
# rib.env. Il se regenere au deploiement, il n'a rien a faire dans le depot.
vm/templates/index.html

# Messages WhatsApp avec adresse et IBAN injectes : ne quitte jamais la machine.
whatsapp/messages_prets.md

# Page publiable fabriquee par site/build_public.py : elle porte l'IBAN en
# clair et 1,8 Mo de photos encodees. Elle se refabrique en une commande.
site/public.build.html

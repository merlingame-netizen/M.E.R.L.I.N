# Caddyfile — site d'anniversaire d'Elise
#
# Écoute UNIQUEMENT sur 127.0.0.1:8791, comme tout le reste de la stack MERLIN.
# Aucun port n'est ouvert sur l'internet : c'est cloudflared qui va chercher le
# site depuis l'intérieur de la VM et l'expose en HTTPS. Rien à modifier dans
# la security list OCI, rien à ouvrir dans ufw.
#
# __BCRYPT_HASH__ est remplacé par deploy-anniv.sh au moment de l'installation.

{
	admin off
	auto_https off
}

http://127.0.0.1:8791 {
	root * /opt/anniv-elise/site

	# Elise ne doit pas tomber dessus par accident. Le mot de passe est la
	# vraie barrière ; l'URL aléatoire du tunnel n'en est pas une.
	basic_auth {
		invite __BCRYPT_HASH__
	}

	file_server
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	log {
		output file /var/log/caddy/anniv-elise.log {
			roll_size 5MiB
			roll_keep 3
		}
		format console
	}
}

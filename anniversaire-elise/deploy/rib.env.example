# Données locales — coordonnées bancaires et adresse du domicile.
#
# ⚠️ Le dépôt merlingame-netizen/M.E.R.L.I.N est PUBLIC. Ni l'IBAN ni l'adresse
# ne doivent y figurer : ils vivent uniquement dans `rib.env`, gitignoré.
#
# Coordonnées bancaires pour la cagnotte — copie ce fichier en `rib.env`
# (gitignoré) et remplis-le. deploy-anniv.sh l'injecte dans la page au moment
# de la publication, ce qui garde l'IBAN hors du dépôt Git.
#
#     cp deploy/rib.env.example deploy/rib.env && $EDITOR deploy/rib.env
#
# Si rib.env est absent, la page affiche « RIB à venir » et le déploiement
# continue normalement.
RIB_TITULAIRE="PRENOM NOM"
RIB_IBAN="FR76 0000 0000 0000 0000 0000 000"
RIB_BIC="XXXXFRPPXXX"
RIB_BANQUE="Nom de la banque"
ADRESSE="Numéro, rue, commune"
